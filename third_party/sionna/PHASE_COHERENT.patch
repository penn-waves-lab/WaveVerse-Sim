@@ -568,9 +568,17 @@ class SolverBase:

         # Extract vertices of every triangle
         # [num_prim, 3]
-        v0 = self._primitives[:,0,:]
-        v1 = self._primitives[:,1,:]
-        v2 = self._primitives[:,2,:]
+        # Use tf.gather instead of [:, k, :] on the tf.Variable: Variable
+        # indexing constructs a ``strided_slice.<locals>.assign`` closure
+        # that captures the Variable, and that closure persists in TF's
+        # internal state long after the SolverBase that owns it is gone.
+        # The result is a steady accumulation of mesh Variables (one set
+        # per scene swap) -- visible as ~50 MB/step growth on multi-scene
+        # training runs. tf.gather has no .assign affordance and avoids
+        # the closure entirely.
+        v0 = tf.gather(self._primitives, 0, axis=1)
+        v1 = tf.gather(self._primitives, 1, axis=1)
+        v2 = tf.gather(self._primitives, 2, axis=1)

         # List all edges
         # [num_prim, 2 + 2 + 2, 3]
